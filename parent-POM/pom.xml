        <module>../bc-work-hour/work-hour-impl</module>

        <module>../bc-anonymize/anonymize-api</module>
        <module>../bc-anonymize/anonymize-impl</module>

        <module>../bc-login/login-api</module>
        <module>../bc-login/login-impl</module>

        <module>../bc-person-notification/person-notification-api</module>
        <module>../bc-person-notification/person-notification-impl</module>

        <module>../bc-sop-education/sop-education-api</module>
        <module>../bc-sop-education/sop-education-impl</module>

