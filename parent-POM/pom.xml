        <module>../bc-sop-instructor/sop-instructor-impl</module>

        <module>../bc-organisation/organisation-api</module>
        <module>../bc-organisation/organisation-impl</module>

        <!-- SAGA -->
        <module>../bc-consent-saga/consent-saga-api</module>
        <module>../bc-consent-saga/consent-saga-impl</module>

        <module>../bc-education-line-saga/education-line-saga-api</module>
        <module>../bc-education-line-saga/education-line-saga-impl</module>

        <module>../bc-education-saga/education-saga-api</module>
        <module>../bc-education-saga/education-saga-impl</module>

