*.zip
*.tar
*.tar.gz

# Test and report files
surefire-reports/
failsafe-reports/
jacoco.exec
target/site/jacoco/

# JVM dumps
hs_err_pid*
*.hprof

# ----------------------------
# IDE / Editor
# ----------------------------
# IntelliJ
.idea/
*.iml
*.iws

# VS Code
.vscode/

# Eclipse
.project
.classpath
.settings/

# Eclipse/STS annotation processing (APT) generated folders
**/.apt_generated/
**/.apt_generated_tests/
**/.factorypath

# ----------------------------
# Node (if you have helper scripts)
# ----------------------------
node_modules/
npm-debug.log*
yarn-error.log*

# ----------------------------
# Docker / Compose
# ----------------------------
# Local overrides that should not be committed
docker-compose.override.yml
docker-compose.local.yml
*.local.compose.yml

# Generated by pipeline
**/Dockerfile
docker-compose.yaml
docker-compose.yml
docker-infra.yaml
docker-infra.yml
.env

# Runtime/volume-like directories (if created locally)
**/tmp/
**/logs/

# ----------------------------
# Configuration & secrets
# ----------------------------
*.env
!.env.example

# Spring Boot environments: keep default, ignore local/secret overrides
application-local.properties
application-local.yml
application-*.secrets.properties
application-*.secrets.yml

# Certificates/keystores
*.jks
*.keystore
*.p12
# *.pem
*.crt
*.key

# ----------------------------
# Databases (local files)
# ----------------------------
*.db
*.sqlite
*.sqlite3

# ----------------------------
# Maven Wrapper — keep these in repo!
# ----------------------------
# mvnw
# mvnw.cmd
# .mvn/wrapper/*

