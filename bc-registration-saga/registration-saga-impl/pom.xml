<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>local.sop.datawarehouse</groupId>
		<artifactId>parent</artifactId>
		<version>${revision}</version>
		<relativePath>../../parent-POM/pom.xml</relativePath>
	</parent>
	<artifactId>registration-saga-impl</artifactId>
	<packaging>jar</packaging>

	<!-- API module dependencies -->
	<dependencies>
		<dependency>
			<groupId>local.sop.datawarehouse</groupId>
			<artifactId>registration-saga-api</artifactId>
			<version>${revision}</version>
		</dependency>

		<!-- shared-kernel inherited-->

		<dependency>
			<groupId>local.sop.common.libs</groupId>
			<artifactId>common-security</artifactId>
		</dependency>


		<dependency>
			<groupId>local.sop.common.libs</groupId>
			<artifactId>common-core</artifactId>
		</dependency>

		<dependency>
			<groupId>local.sop.common.libs</groupId>
			<artifactId>common-web</artifactId>
		</dependency>

		<!-- Spring Boot starters -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Configuration metadata processor for @ConfigurationProperties -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
		</dependency>

		<!--Test containers-->
		<!-- https://mvnrepository.com/artifact/org.testcontainers/junit-jupiter -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

		<!-- Optional: pin the main class for the Boot plugin -->
	<properties>
		<start-class>local.sop.datawarehouse.registration.saga.RegistrationSagaStartApplication</start-class>
		<spring-boot.run.skip>false</spring-boot.run.skip>
	</properties>

	<build>
		<plugins>
			<!-- activate flatten-plugin, config/vers. from parent -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>flatten-maven-plugin</artifactId>
			</plugin>

			<!-- Create an executable Spring Boot jar -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<executions>
					<execution>
						<goals><goal>repackage</goal></goals>
					</execution>
				</executions>
				<!-- (Optional) if auto-detection fails, use the start-class property -->
				<configuration>
					<mainClass>${start-class}</mainClass>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>