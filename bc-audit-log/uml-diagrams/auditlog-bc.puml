Log "1" *-- "1" OriginService
Log "1" *-- "1" OriginComponent
Log "1" *-- "1" Data
Log "1" *-- "1" Description
Log "1" *-- "1" LogTimestamp
Log "1" *-- "1" Severity
Log "1" *-- "1" ActorType

' Domain service
AuditlogDomainService ..|> AuditLogDomain : implements
AuditlogDomainConfig ..> AuditLogDomain : creates >

' Application layer
AuditlogApplicationService ..|> AuditlogDirectory : implements
AuditlogApplicationService --> AuditLogDomain : uses >
AuditlogApplicationService --> AuditlogRepositoryPort : uses >

' Inbound adapter
AuditlogDirectoryAdapter ..|> AuditlogDirectory : implements
AuditlogDirectoryAdapter --> AuditlogDirectory : delegates to >

' Web adapter
AuditlogController --> AuditlogDirectory : injects >

' Persistence adapter
AuditlogRepositoryAdapter ..|> AuditlogRepositoryPort : implements
AuditlogRepositoryAdapter --> AuditlogSpringDataRepository : uses >
AuditlogRepositoryAdapter --> AuditlogJpaMapper : uses >
AuditlogJpaMapper --> AuditlogEntity : maps >
AuditlogJpaMapper --> Log : maps >
AuditlogSpringDataRepository --> AuditlogEntity : queries >

' Converters
AuditlogEntity ..> ActorTypeConverter : @Convert >
AuditlogEntity ..> SeverityConverter : @Convert >

' DTO cross-references (ActorType/Severity come from shared-kernel)
