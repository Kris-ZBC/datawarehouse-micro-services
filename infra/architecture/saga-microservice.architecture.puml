@startuml saga-architecture
title Saga microservice architecture

skinparam component {
    BackgroundColor<<web>>         #D4F1E4
    BorderColor<<web>>             #0F6E56
    FontColor<<web>>               #085041

    BackgroundColor<<application>> #EEEDFE
    BorderColor<<application>>     #534AB7
    FontColor<<application>>       #3C3489

    BackgroundColor<<port>>        #FBEAF0
    BorderColor<<port>>            #993556
    FontColor<<port>>              #72243E

    BackgroundColor<<adapter>>     #E6F1FB
    BorderColor<<adapter>>         #185FA5
    FontColor<<adapter>>           #0C447C

    BackgroundColor<<external>>    #FAEEDA
    BorderColor<<external>>        #854F0B
    FontColor<<external>>          #633806

    BackgroundColor<<infra>>       #F1EFE8
    BorderColor<<infra>>           #5F5E5A
    FontColor<<infra>>             #2C2C2A
}

skinparam package {
    BackgroundColor #FFFFFF
    BorderColor     #888780
    FontColor       #2C2C2A
    FontStyle       bold
}

skinparam arrow {
    Color           #5F5E5A
    FontColor       #5F5E5A
    FontSize        11
}

skinparam defaultFontName  Helvetica
skinparam defaultFontSize  12
skinparam shadowing        false
skinparam roundCorner      12
skinparam linetype         ortho

' ── External caller ───────────────────────────────────────────
component "External caller\n(other saga, handler or gateway / client via mTLS)" <<external>> as caller

' ── bc-<x>-saga ───────────────────────────────────────────────
package "bc-<x>-saga  [no domain model · no JPA · stateless]" {

    package "Interface web" {
        component "<X>SagaController\nREST endpoint · receives saga cmd" <<web>> as controller
    }

    package "Application layer" {
        component "<X>SagaDirectory\n(public API interface)" <<application>> as directory

        component "<X>SagaApplicationService\n\nOrchestrates steps in sequence:\n  1. call <A>Port · on fail → throw\n  2. call <B>Port · on fail → compensate <A> → throw\n  N. on any fail → compensate all in reverse order\n\nSagaOutcome: SUCCEEDED · COMPENSATED · PARTIAL_FAILURE" <<application>> as appservice
    }

    package "Ports out" {
        component "<A>Port\ncreate · get · compensate" <<port>> as portA
        component "<B>Port\ncreate · get · compensate" <<port>> as portB
    }

    package "HTTP adapters" {
        component "<A>HttpAdapter\nRestClient · mTLS\nPayload / Response DTOs" <<adapter>> as adapterA
        component "<B>HttpAdapter\nRestClient · mTLS\nPayload / Response DTOs" <<adapter>> as adapterB
    }
}

' ── Shared infra ──────────────────────────────────────────────
component "common-security\nmTLS · RestClient SSL bundle\nServiceClientConfig" <<infra>> as security

' ── Target BCs ────────────────────────────────────────────────
component "bc-<A>\nInternal REST endpoint" <<external>> as bcA
component "bc-<B>\nInternal REST endpoint" <<external>> as bcB

' ── Relationships ─────────────────────────────────────────────
caller     -->  controller  : mTLS
controller -->  directory   : delegates
directory  -->  appservice  : implements
appservice -->  portA
appservice -->  portB
portA      <..  adapterA    : implements
portB      <..  adapterB    : implements
adapterA   -->  bcA         : HTTP / mTLS
adapterB   -->  bcB         : HTTP / mTLS
security   -->  adapterA
security   -->  adapterB

@enduml
